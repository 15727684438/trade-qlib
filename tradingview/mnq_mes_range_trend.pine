//@version=6
// MNQ/MES Range & Trend Regime (MRT) - Pine v6 indicator
// =======================================================
// Faithful port of docs/regime-indicator-spec.md (canonical contract):
//   §2 -> inputs below (group "Regime" and group "Display")
//   §3 -> computations (ta.* builtins ONLY; Wilder smoothing; windows inclusive of current bar)
//   §4 -> signals with precedence RANGE < TREND < BRKOUT (breakout wins)
//   §5 -> single-pane overlay display + top-right table (state, ADX, span_atr, RSI)
//
// Parity notes (spec §6):
//   - ta.atr / ta.adx / ta.rsi use Wilder smoothing (== TA-Lib defaults)
//   - ta.stdev(close, len) returns the POPULATION standard deviation (ddof=0, == TA-Lib)
//   - EMA smoothing = 2/(n+1)
//   - Donchian / BB / EMA rolling windows are inclusive of the current bar
//     (ta.highest / ta.lowest / ta.sma / ta.stdev default behavior)
//   - A single indicator() renders in ONE pane; ADX/RSI values are shown in the
//     table instead of a second sub-pane (an ADX line plot is omitted - the table
//     value is sufficient and avoids distorting the price scale).

indicator("MNQ/MES Range & Trend Regime (MRT)", "MRT", overlay=true, precision=2, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// ============ §2 Parameters: Regime ============
atr_len       = input.int(14, "ATR Length (atr_len)", minval=1, group="Regime")
adx_len       = input.int(14, "ADX Length (adx_len)", minval=1, group="Regime")
adx_threshold = input.float(20.0, "ADX Threshold (adx_threshold)", step=0.5, group="Regime")
ema_fast_len  = input.int(9, "Fast EMA Length (ema_fast_len)", minval=1, group="Regime")
ema_slow_len  = input.int(21, "Slow EMA Length (ema_slow_len)", minval=1, group="Regime")
donch_len     = input.int(20, "Donchian Length (donch_len)", minval=1, group="Regime")
bb_len        = input.int(20, "Bollinger Length (bb_len)", minval=1, group="Regime")
bb_mult       = input.float(2.0, "BB Std Multiplier (bb_mult)", step=0.1, group="Regime")
rsi_len       = input.int(14, "RSI Length (rsi_len)", minval=1, group="Regime")
chan_atr_min  = input.float(1.0, "Min span/ATR for Trend (chan_atr_min)", step=0.1, group="Regime")

// ============ §2 Parameters: Display ============
show_donchian    = input.bool(true, "Show Donchian Channel", group="Display")
show_ema         = input.bool(true, "Show EMAs", group="Display")
show_bb          = input.bool(false, "Show Bollinger Bands", group="Display")
color_background = input.bool(true, "Color Background by Regime", group="Display")
show_signals     = input.bool(true, "Show Signals", group="Display")

// ============ §3 Computations (per bar, after warmup) ============
atr      = ta.atr(high, low, close, atr_len)     // Wilder ATR
adx      = ta.adx(high, low, close, adx_len)     // Wilder ADX
ema_fast = ta.ema(close, ema_fast_len)           // EMA smoothing 2/(n+1)
ema_slow = ta.ema(close, ema_slow_len)
don_hi   = ta.highest(high, donch_len)           // rolling, current bar inclusive
don_lo   = ta.lowest(low, donch_len)
bb_mid   = ta.sma(close, bb_len)
bb_std   = ta.stdev(close, bb_len)               // POPULATION stdev (ddof=0)
bb_hi    = bb_mid + bb_mult * bb_std
bb_lo    = bb_mid - bb_mult * bb_std
rsi      = ta.rsi(close, rsi_len)                // Wilder RSI

span_atr = (don_hi - don_lo) / atr
trending = (adx >= adx_threshold) and (span_atr >= chan_atr_min)
up   = close > ema_slow
down = close < ema_slow
// state per spec §3: TREND_UP (=1), TREND_DOWN (=-1), RANGE (=0). Int series.
// Exact parity with mrind.py: close == ema_slow -> neither up nor down -> RANGE.
int state = trending and up ? 1 : (trending and down ? -1 : 0)

// Prior-bar Donchian (spec §4 breakout uses don_hi_prev / don_lo_prev)
don_hi_prev = don_hi[1]
don_lo_prev = don_lo[1]

// ============ §4 Signals ============
// Long signals (dir = +1)
is_range_long  = state == 0 and low <= don_lo and rsi < 45
is_trend_long  = state == 1 and low <= ema_fast and close > ema_slow
is_brkout_long = state == 1 and ta.crossover(close, don_hi_prev)

// Short signals (dir = -1)
is_range_short  = state == 0 and high >= don_hi and rsi > 55
is_trend_short  = state == -1 and high >= ema_fast and close < ema_slow
is_brkout_short = state == -1 and ta.crossunder(close, don_lo_prev)

// Tag precedence (spec §4): RANGE_LONG < TREND_LONG < BRKOUT_LONG (breakout most
// meaningful); the same ordering applies for shorts. Highest precedence wins per bar.
sig_brkout_long  = is_brkout_long
sig_trend_long   = is_trend_long and not is_brkout_long
sig_range_long   = is_range_long and not is_trend_long and not is_brkout_long
long_signal      = sig_brkout_long or sig_trend_long or sig_range_long
long_tag         = sig_brkout_long ? "BRKOUT_LONG" : sig_trend_long ? "TREND_LONG" : sig_range_long ? "RANGE_LONG" : ""

sig_brkout_short  = is_brkout_short
sig_trend_short   = is_trend_short and not is_brkout_short
sig_range_short   = is_range_short and not is_trend_short and not is_brkout_short
short_signal      = sig_brkout_short or sig_trend_short or sig_range_short
short_tag         = sig_brkout_short ? "BRKOUT_SHORT" : sig_trend_short ? "TREND_SHORT" : sig_range_short ? "RANGE_SHORT" : ""

// Regime-change detection (used by alert conditions)
regime_up    = state == 1 and state[1] != 1
regime_down  = state == -1 and state[1] != -1
regime_range = state == 0 and state[1] != 0

// ============ §5 Display ============
// Donchian channel: hi/lo lines + fill between them
don_hi_color = show_donchian ? color.new(color.teal, 35) : na
don_lo_color = show_donchian ? color.new(color.teal, 35) : na
don_hi_plot  = plot(don_hi, "Donchian High", color=don_hi_color, linewidth=1)
don_lo_plot  = plot(don_lo, "Donchian Low", color=don_lo_color, linewidth=1)
fill(don_hi_plot, don_lo_plot, title="Donchian Fill", color=show_donchian ? color.new(color.teal, 92) : na)

// EMAs: fast and slow
ema_fast_color = show_ema ? color.new(color.orange, 0) : na
ema_slow_color = show_ema ? color.new(color.blue, 0) : na
plot(ema_fast, "Fast EMA", color=ema_fast_color, linewidth=2)
plot(ema_slow, "Slow EMA", color=ema_slow_color, linewidth=2)

// Bollinger Bands (optional): bb_hi / bb_lo / mid
bb_hi_color  = show_bb ? color.new(color.purple, 20) : na
bb_lo_color  = show_bb ? color.new(color.purple, 20) : na
bb_mid_color = show_bb ? color.new(color.purple, 20) : na
bb_hi_plot   = plot(bb_hi, "BB High", color=bb_hi_color, linewidth=1)
bb_lo_plot   = plot(bb_lo, "BB Low", color=bb_lo_color, linewidth=1)
plot(bb_mid, "BB Mid", color=bb_mid_color, linewidth=1)
fill(bb_hi_plot, bb_lo_plot, title="BB Fill", color=show_bb ? color.new(color.purple, 95) : na)

// Background by regime: TREND_UP green, TREND_DOWN red, RANGE gray-blue (~90% transparency)
state_bg_color = state == 1 ? color.new(color.green, 90) : state == -1 ? color.new(color.red, 90) : color.new(color.rgb(100, 116, 139), 90)
bgcolor(color_background ? state_bg_color : na)

// Signal markers: up triangle (green) below bar for longs, down triangle (red) above
// bar for shorts; the tag (RANGE_LONG / TREND_LONG / BRKOUT_LONG / ...) is shown as
// short text next to each triangle.
plotshape(long_signal, "Long Signal", location=location.belowbar, style=shape.triangleup, color=show_signals ? color.new(color.green, 0) : na, text=show_signals ? long_tag : "", textcolor=color.new(color.green, 0), size=size.small)
plotshape(short_signal, "Short Signal", location=location.abovebar, style=shape.triangledown, color=show_signals ? color.new(color.red, 0) : na, text=show_signals ? short_tag : "", textcolor=color.new(color.red, 0), size=size.small)

// Table (top-right): state, ADX, span_atr, RSI - updated every bar.
// ADX/RSI sub-pane is not possible in a single-pane indicator(); the table values
// are the equivalent display (an ADX threshold line on the price pane is omitted).
var table mrt_table = table.new(position.top_right, 2, 5, bgcolor=color.new(color.black, 50), border_width=1, border_color=color.new(color.gray, 50))

table.cell(mrt_table, 0, 0, "Metric", text_color=color.white, bgcolor=color.new(color.gray, 40), text_size=size.small)
table.cell(mrt_table, 1, 0, "Value", text_color=color.white, bgcolor=color.new(color.gray, 40), text_size=size.small)

state_label   = state == 1 ? "TREND_UP" : state == -1 ? "TREND_DOWN" : "RANGE"
state_cell_bg = state == 1 ? color.new(color.green, 40) : state == -1 ? color.new(color.red, 40) : color.new(color.rgb(100, 116, 139), 40)
table.cell(mrt_table, 0, 1, "State", text_color=color.white, text_size=size.small)
table.cell(mrt_table, 1, 1, state_label, text_color=color.white, bgcolor=state_cell_bg, text_size=size.small)

table.cell(mrt_table, 0, 2, "ADX", text_color=color.white, text_size=size.small)
table.cell(mrt_table, 1, 2, str.tostring(adx, "#.##"), text_color=color.white, text_size=size.small)

table.cell(mrt_table, 0, 3, "span/ATR", text_color=color.white, text_size=size.small)
table.cell(mrt_table, 1, 3, str.tostring(span_atr, "#.##"), text_color=color.white, text_size=size.small)

table.cell(mrt_table, 0, 4, "RSI", text_color=color.white, text_size=size.small)
table.cell(mrt_table, 1, 4, str.tostring(rsi, "#.##"), text_color=color.white, text_size=size.small)

// ============ Alert conditions (spec §5) ============
alertcondition(regime_up, "Regime changed to TREND_UP", "Regime changed to TREND_UP")
alertcondition(regime_down, "Regime changed to TREND_DOWN", "Regime changed to TREND_DOWN")
alertcondition(regime_range, "Regime changed to RANGE", "Regime changed to RANGE")
alertcondition(sig_range_long, "RANGE_LONG", "RANGE_LONG")
alertcondition(sig_trend_long, "TREND_LONG", "TREND_LONG")
alertcondition(sig_brkout_long, "BRKOUT_LONG", "BRKOUT_LONG")
alertcondition(sig_range_short, "RANGE_SHORT", "RANGE_SHORT")
alertcondition(sig_trend_short, "TREND_SHORT", "TREND_SHORT")
alertcondition(sig_brkout_short, "BRKOUT_SHORT", "BRKOUT_SHORT")
